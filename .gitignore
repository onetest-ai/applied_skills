# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Superpowers SDD workspace (ledgers, briefs, review packages — scratch)
.superpowers/

# Local task tracking (Brain feedback follow-ups — not shipped in the toolkit)
/tasks/

# Brain build artifacts — never commit a built brain into the toolkit repo
# (these are created in a CONSUMING project, but guard against building inside a checkout)
*.sqlite
*.sqlite.bak-*
knowledge.sqlite*
/vault/
/assets/
/parsed/
.mcp.json
sync_plan.json
result_*.json
batch_*.json

# Host-specific MCP/skill install directories — each host clones its own copy.
# NOTE: only the Copilot install target under .github/skills/ is ignored, so the
# rest of .github/ (issue templates, PR template, workflows) stays tracked.
.claude/
.codex/
.dsh/
.github/skills/
# Internal spec-driven-development scratch (plans/specs) — not shipped in the toolkit.
# docs/ itself is tracked (user-facing guides); only the superpowers workspace is ignored.
docs/superpowers/
# Local environment overrides — never commit (paths are machine-specific)
.env

# Eval output artifacts — generated per-run, not committed
evals/temporal_cross_session.csv
retrieval-results.json
retrieval-results.html

# JetBrains IDE
.idea/
