{"task": "9a090e2b", "evidence": "2026-03-03_meetings_9a090e2b", "transcript_sha": "15a7086c427eb9a248ffc0336a612c8102fef58866018cd11e31d25da55c5668", "must_create": [{"id": "9a090e2b-c01", "span": [246, 337], "quote": "I will build the current-state findings report for the client and have it ready by Thursday.", "kind": "task", "commitment": "committed", "owner": "Nora Quill", "caps": ["committed", "owners"], "source": "golden seed 1: planted/planted:commitment", "status": "draft", "difficulty": null, "pending_ruling": false, "category": null, "family": "planted:commitment", "title": "Build current-state findings report"}, {"id": "9a090e2b-c02", "span": [913, 992], "quote": "Nora, can you build the dock-scan error summary for the client before the review?", "kind": "task", "commitment": "committed", "owner": "Nora Quill", "caps": ["committed", "owners"], "source": "golden seed 1: planted/planted:request", "status": "draft", "difficulty": null, "pending_ruling": false, "category": null, "family": "planted:request", "title": "Build dock-scan error summary"}, {"id": "9a090e2b-c03", "span": [1786, 1859], "quote": "We need to deliver the supplier scorecard to the client by next Wednesday.", "kind": "task", "commitment": "committed", "owner": "Nora Quill", "caps": ["committed", "owners"], "source": "golden seed 1: planted/planted:due_phrase", "status": "draft", "difficulty": null, "pending_ruling": false, "category": null, "family": "planted:due_phrase", "title": "Deliver supplier scorecard to client"}], "must_not_create": [{"id": "9a090e2b-n01", "span": [87, 178], "quote": "Ravi, can you take a look at the workshop deck and tweak the slide titles before it goes out?", "why": "not_work", "caps": ["not_work"], "source": "golden seed 1: planted/planted:not_work", "status": "draft", "difficulty": null, "pending_ruling": true, "category": "WORKSHOP_HANDLING", "family": "planted:not_work", "title": "Tweak workshop deck slide titles"}, {"id": "9a090e2b-n02", "span": [425, 508]