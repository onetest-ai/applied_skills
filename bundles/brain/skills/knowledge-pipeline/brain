#!/usr/bin/env bash
# brain — one entry point so an agent NEVER has to guess where to run.
#
# It self-discovers, in this order (each overridable by an env var):
#   • skills dir  — <self>/.claude/skills, .dsh, .codex, .github  (or $BRAIN_SKILLS;
#                   also works when this launcher lives inside the skills dir itself)
#   • interpreter — $BRAIN_PY → the venv next to the skills (<host>/venv) →
#                   a shared ~/.claude/venv | ~/.dsh/venv | … → python3
#   • store (db)  — $BRAIN_DB → <self>/knowledge.sqlite → <self>/schema/knowledge.sqlite
#
# Usage:
#   ./brain which                 # print the resolved skills / python / db
#   ./brain about                 # print the store's recorded analytical goal + audience
#   ./brain search "<question>" [k] [--full|--chars N|--json]
#   ./brain sources [--like SUBSTR] [--json]   # catalog of indexed source docs
#   ./brain sql "SELECT … FROM facts …"
#   ./brain verify ["<smoke query>"]
#   ./brain plan   <parsed-dir>      # what changed since last build (added/changed/deleted)
#   ./brain update <parsed-dir>      # incremental apply (snapshot + delta); prints reclassify order
#   ./brain rollback                 # restore the latest pre-update snapshot
#   ./brain source <command> ...     # portable source registry (list/import/adopt/plan/remove)
#   ./brain vault  [out-dir]         # (re)export the Obsidian vault on demand — a disposable view
#   ./brain py <script.py> [args…]   # run any skill script with the right interpreter
set -euo pipefail
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_skills() {
  if [ -n "${BRAIN_SKILLS:-}" ] && [ -d "$BRAIN_SKILLS/knowledge-index" ]; then echo "$BRAIN_SKILLS"; return; fi
  for d in "$SELF/.claude/skills" "$SELF/.dsh/skills" "$SELF/.codex/skills" "$SELF/.github/skills"; do
    [ -d "$d/knowledge-index" ] && { echo "$d"; return; }
  done
  # launcher installed inside the skills dir (…/skills/knowledge-pipeline/brain)?
  case "$SELF" in */knowledge-pipeline) [ -d "$(dirname "$SELF")/knowledge-index" ] && { dirname "$SELF"; return; };; esac
  echo ""
}
SKILLS="$(find_skills)"
[ -n "$SKILLS" ] || { echo "brain: cannot find a skills dir (set BRAIN_SKILLS to the dir holding knowledge-index/)"; exit 1; }

find_py() {
  [ -n "${BRAIN_PY:-}" ] && { echo "$BRAIN_PY"; return; }
  local host; host="$(dirname "$SKILLS")"                 # e.g. <root>/.claude
  for p in "$host/venv/bin/python" \
           "$HOME/.claude/venv/bin/python" "$HOME/.dsh/venv/bin/python" \
           "$HOME/.codex/venv/bin/python" "$HOME/.copilot/venv/bin/python"; do
    [ -x "$p" ] && { echo "$p"; return; }
  done
  command -v python3
}
PY="$(find_py)"

find_db() {
  [ -n "${BRAIN_DB:-}" ] && { echo "$BRAIN_DB"; return; }
  for d in "$SELF/knowledge.sqlite" "$SELF/schema/knowledge.sqlite" \
           "$SELF/.dsh/knowledge.sqlite" "$SELF/.claude/knowledge.sqlite" \
           "$SELF/.codex/knowledge.sqlite" "$SELF/.github/knowledge.sqlite"; do
    [ -f "$d" ] && { echo "$d"; return; }
  done
  echo ""
}
DB="$(find_db)"

need_db() { [ -n "$DB" ] || { echo "brain: no store found (set BRAIN_DB, or place knowledge.sqlite next to this launcher)"; exit 1; }; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  which)  echo "skills = $SKILLS"; echo "python = $PY"; echo "db     = ${DB:-<none>}";;
  mcp-config|mcp)  # locate the installed MCP server: <host>/mcp/brain/ (sibling of skills/)
    SRVDIR="$(dirname "$SKILLS")/mcp/brain"
    SRV="$SRVDIR/fastmcp_server.py"
    [ -f "$SRV" ] || SRV="$SRVDIR/brain_mcp.py"             # legacy install fallback
    [ -f "$SRV" ] || { echo "brain: MCP server not installed (run install with --mcp)"; exit 1; }
    if [ "$cmd" = "mcp" ]; then exec "$PY" "$SRV" --transport stdio; fi
    CAT="${BRAIN_CATALOG:-}"
    if [ -z "$CAT" ]; then
      for c in "$(dirname "$DB")"/metrics.*.json "$SELF"/schema/metrics.*.json; do
        [ -f "$c" ] && { CAT="$c"; break; }
      done
    fi
    "$PY" - "$PY" "$SRV" "$SKILLS" "$DB" "$CAT" "${BRAIN_ASSETS:-}" <<'PY'
import json, sys
py, server, skills, db, catalog, assets = sys.argv[1:7]
env = {"BRAIN_SKILLS": skills}
if db: env["BRAIN_DB"] = db
if catalog: env["BRAIN_CATALOG"] = catalog
if assets: env["BRAIN_ASSETS"] = assets
print(json.dumps({"mcpServers": {"brain": {
    "command": py, "args": [server, "--transport", "stdio"], "env": env
}}}, indent=2))
PY
    ;;
  search)
    need_db; q="${1:?question}"; shift
    k=5; if [[ "${1:-}" =~ ^[0-9]+$ ]]; then k="$1"; shift; fi   # optional positional k; keeps back-compat
    "$PY" "$SKILLS/knowledge-index/knowledge_index.py" search --db "$DB" --query "$q" --k "$k" "$@"  # extra flags (--full/--chars/--json) pass through
    ;;
  sources) need_db; "$PY" "$SKILLS/knowledge-index/knowledge_index.py" sources --db "$DB" "$@";;
  sql)    need_db; "$PY" "$SKILLS/hybrid-retrieval/query.py" --db "$DB" --sql "${1:?SQL}";;
  verify) need_db; "$PY" "$SKILLS/knowledge-pipeline/onboard.py" verify --db "$DB" ${1:+--query "$1"};;
  py)     "$PY" "$@";;
  plan)
    need_db; parsed="${1:?parsed-dir}"; shift
    "$PY" "$SKILLS/knowledge-pipeline/brain_sync.py" plan --db "$DB" --parsed "$parsed" "$@"
    ;;
  update)
    need_db; parsed="${1:?parsed-dir}"; shift
    "$PY" "$SKILLS/knowledge-pipeline/brain_sync.py" apply --db "$DB" --parsed "$parsed" "$@"
    ;;
  rollback) need_db; "$PY" "$SKILLS/knowledge-pipeline/brain_sync.py" rollback --db "$DB";;
  about)    need_db; "$PY" "$SKILLS/knowledge-pipeline/brain_sync.py" about --db "$DB";;
  source)
    sub="${1:-}"; shift || true
    if [ -z "$DB" ] && [ "$sub" = "init" ]; then
      DB="${BRAIN_DB:-$SELF/schema/knowledge.sqlite}"; mkdir -p "$(dirname "$DB")"
    fi
    need_db
    "$PY" "$SKILLS/knowledge-pipeline/source_registry.py" --db "$DB" "$sub" "$@"
    ;;
  related)  need_db; "$PY" "$SKILLS/knowledge-index/knowledge_index.py" related --db "$DB";;
  vault)    need_db  # regenerate the Obsidian vault ON DEMAND (it's a disposable view of the store)
    out="${1:-$(dirname "$DB")/vault}"
    assets="${BRAIN_ASSETS:-$(dirname "$DB")/assets}"; af=""; [ -d "$assets" ] && af="--assets $assets"
    "$PY" "$SKILLS/corpus-taxonomy-extraction/to_obsidian.py" --db "$DB" --out "$out" --clean $af
    ;;
  *) sed -n '3,26p' "$0"; exit 2;;
esac
